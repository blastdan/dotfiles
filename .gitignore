.devbox

# GitHub CLI credentials
.config/gh/hosts.yml

# gcloud credentials, tokens, logs
.config/gcloud/access_tokens.db
.config/gcloud/credentials.db
.config/gcloud/default_configs.db
.config/gcloud/legacy_credentials/
.config/gcloud/logs/
.config/gcloud/application_default_credentials.json
.config/gcloud/config_sentinel
.config/gcloud/.last_survey_prompt.yaml
.config/gcloud/gce

# PulseAudio
.config/pulse/

# JetBrains telemetry/IDs
.config/JetBrains/

# NPM/configstore update notifiers
.config/configstore/

# mise secrets (local-only)
.config/mise/secrets.sh
.secrets.local

# Tmux plugins (managed by tpm, not committed)
.config/tmux/plugins/

# Python bytecode from stowed hook.py
.config/claude-dashboard/__pycache__/
.config/claude-dashboard/*.pyc

# Claude Code / OpenCode agent instruction files (loaded from cwd, not versioned)
CLAUDE.md
AGENTS.md

# OpenCode runtime state
.config/opencode/opencode-notifier-state.json
.config/opencode/package-lock.json
.config/opencode/package.json
.config/opencode/node_modules/

# Serena runtime cache and local state
.serena/cache/
.serena/memories/
.serena/project.local.yml

# Junk / auto-generated app configs (not useful in dotfiles)
.config/QtProject/
.config/QtProject.conf
.config/create-next-app-nodejs/
.config/nextjs-nodejs/
.config/gcloud/
.config/google-chrome-for-testing/
.config/google-chrome/
.config/kaggle/
.config/matplotlib/
.config/procps/
.config/wslu/
.config/go/
.config/jgit/
.config/Code/

# SDD scratch workspace (subagent-driven-development)
.superpowers/

# Stray tmux client logs left by verification work
tmux-client-*.log

# Superpowers specs/plans: working notes, not part of the dotfiles
docs/superpowers/

# Per-project tmuxinator layouts generated by proj-new: they embed the repo name
# and an absolute home path, and this repo is public.
.config/tmuxinator/*_*.yml
