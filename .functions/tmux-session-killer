#!/bin/zsh
# tmux-session-killer: fzf multi-select session picker → kill selected sessions
# Usage: tmux-session-killer
# Bind: Ctrl-a K

current=$(tmux display-message -p '#S')

# Build display records: DISPLAY \t SESSION_NAME \t PATH \t WINDOWS \t STATUS
# Same pattern as tmux-cheatsheet: prepend a formatted display field for --with-nth=1
entries=()
while IFS='|' read -r sess_name sess_path sess_windows sess_status; do
  [[ "$sess_name" == "$current" ]] && continue
  display="$(printf '%-20s  %-10s  %-6s  %s' "$sess_name" "$sess_status" "$sess_windows" "$sess_path")"
  entries+=("${display}"$'\t'"${sess_name}"$'\t'"${sess_path}"$'\t'"${sess_windows}"$'\t'"${sess_status}")
done < <(tmux list-sessions -F '#{session_name}|#{session_path}|#{session_windows}w|#{?session_attached,attached,detached}')

if [[ ${#entries[@]} -eq 0 ]]; then
  tmux display-message "No other sessions to kill."
  return 0
fi

header="$(printf '%-20s  %-10s  %-6s  %s' 'SESSION' 'STATUS' 'WINS' 'PATH')"

selected=$(printf '%s\n' "${entries[@]}" \
  | fzf \
      --multi \
      --prompt="  kill> " \
      --delimiter=$'\t' \
      --with-nth=1 \
      --nth='1,2,3,4,5' \
      --header="$header" \
      --header-first \
      --preview='
        sess_name="{2}"
        sess_path="{3}"
        sess_status="{5}"
        printf "\033[1;31mSession:\033[0m  %s\n\n" "$sess_name"
        printf "\033[1;36mStatus:\033[0m   %s\n" "$sess_status"
        printf "\033[1;36mPath:\033[0m     %s\n\n" "$sess_path"
        printf "\033[1;33mWindows:\033[0m\n"
        tmux list-windows -t "$sess_name" -F "  #I  #W  (#{pane_current_command})" 2>/dev/null
      ' \
      --preview-window='right:40%:wrap' \
      --height=100% \
      --bind='tab:toggle+down')

[[ -z "$selected" ]] && return 0

printf '%s' "$selected" | awk -F'\t' '{print $2}' | while IFS= read -r session; do
  tmux kill-session -t "$session"
done
