#!/bin/zsh
# tmux-sessionizer: fzf project picker → named tmux session
# Usage: tmux-sessionizer [path]
# Bind: Ctrl-a T
#
# Understands bare repos with worktrees: lists each worktree as an individual
# entry and names sessions "repo_branch" for easy identification.

# Works in both invocation modes: autoloaded as a function, and executed
# directly as a script (tmux run-shell / display-popup -E). In script mode
# tmux-session-name is not autoloaded, so resolve it relative to this file.
if ! typeset -f tmux-session-name >/dev/null 2>&1; then
  fpath=("${${(%):-%x}:A:h}" $fpath)
  autoload -Uz tmux-session-name
fi

REPOS_ROOT="$HOME/source/repos"

if [[ $# -eq 1 ]]; then
  selected="$1"
else
  # Collect candidates as (path, group, name) triples. `group` is the containing
  # repo — for a bare repo's worktrees that is the repo itself — and `name` is
  # the part that identifies the worktree within it. Showing a full absolute
  # path per row made the list unreadable; grouping is what tells you what you
  # are looking at.
  local -a c_path c_group c_name
  local -A seen
  local org_dir repo_dir line wt d

  _add() {  # _add <path> <group> <name>
    [[ -z "$1" || -n "${seen[$1]}" ]] && return 0
    seen[$1]=1
    c_path+=("$1"); c_group+=("$2"); c_name+=("$3")
  }

  # (-/N): directories only, following symlinks (matching the [[ -d ]] this
  # replaced), and empty rather than a fatal NOMATCH when nothing matches.
  for org_dir in "$REPOS_ROOT"/*(-/N); do
    for repo_dir in "$org_dir"/*(-/N); do
      repo_dir="${repo_dir%/}"
      git -C "$repo_dir" rev-parse --git-dir &>/dev/null || continue

      if [[ "$(git -C "$repo_dir" rev-parse --is-bare-repository 2>/dev/null)" == "true" ]]; then
        # Bare repo: each worktree is its own candidate, named by its path
        # relative to the repo root — which is the branch-ish part the user
        # recognises, and keeps nested names like feat/login intact.
        while IFS= read -r line; do
          [[ "$line" == worktree\ * ]] || continue
          wt="${line#worktree }"
          if [[ "$wt" == "$repo_dir" ]]; then
            _add "$wt" "${repo_dir:t}" "(bare)"
          else
            _add "$wt" "${repo_dir:t}" "${wt#$repo_dir/}"
          fi
        done < <(git -C "$repo_dir" worktree list --porcelain 2>/dev/null)
      else
        # Regular clone: grouped under its org, named by the repo.
        _add "$repo_dir" "${org_dir:t}" "${repo_dir:t}"
      fi
    done
  done

  # Shallow fallback: direct children of ~/source only. Sweeping all of $HOME
  # buried real projects under dotfile and cache directories.
  while IFS= read -r d; do
    _add "$d" "source" "${d:t}"
  done < <(find "$HOME/source" -mindepth 1 -maxdepth 1 -type d 2>/dev/null \
    | grep -v "^$REPOS_ROOT$")
  unfunction _add

  # Prefix each candidate with ● when a session already exists for it, ○ when not.
  #
  # Match on the sessions' PATHS, gathered in one tmux call, rather than deriving
  # each candidate's session NAME. Deriving the name costs two git invocations
  # per candidate, which measured 1.8s across ~100 candidates — far too slow for
  # a popup that opens on every prefix+T. Comparing paths is a single tmux call
  # total and answers the same question: is there a session for this directory?
  # Both lookups below use zsh builtins rather than spawning a process per
  # candidate. With ~100 candidates, `grep` + `stat` per row cost ~200 forks and
  # measured multiple seconds; an associative array and zstat are in-process.
  zmodload -F zsh/stat b:zstat 2>/dev/null
  local -A live_map
  local lp
  while IFS= read -r lp; do
    [[ -n "$lp" ]] && live_map[$lp]=1
  done < <(tmux list-sessions -F '#{session_path}' 2>/dev/null)
  # mtime orders the list. It is a zstat, not git — deliberately cheap, because
  # this runs every time the prefix+T popup opens. Anything git-based (last
  # commit date, merge status) costs hundreds of ms across ~100 candidates;
  # gwt-tidy does that work when explicitly asked. mtime is only a display-order
  # hint, so nothing destructive depends on its accuracy.
  local -a rows
  local -A group_recent
  local i p g n mt
  local -a st
  for i in {1..${#c_path}}; do
    p="${c_path[$i]}"; g="${c_group[$i]}"; n="${c_name[$i]}"
    # Drop candidates whose directory is gone: git worktree list still
    # enumerates prunable worktrees, and a stale row can neither be selected nor
    # show a meaningful marker.
    [[ -d "$p" ]] || continue
    mt=0
    if zstat -A st +mtime "$p" 2>/dev/null; then mt="${st[1]}"; fi
    (( mt > ${group_recent[$g]:-0} )) && group_recent[$g]=$mt
    rows+=("${g}"$'\t'"${mt}"$'\t'"${p}"$'\t'"${n}")
  done

  # Two-level ordering: groups ranked by their most recent activity, and within
  # a group the worktrees by their own recency. Grouping alone would bury the
  # repo you are actually working in; recency alone loses the grouping that
  # makes the list legible.
  local -a display_rows
  local gmax marker
  for i in {1..${#rows}}; do
    IFS=$'\t' read -r g mt p n <<< "${rows[$i]}"
    gmax="${group_recent[$g]:-0}"
    if [[ -n "${live_map[$p]}" ]]; then marker="●"; else marker="○"; fi
    # sortkey1 = group recency (desc), sortkey2 = group name (ties), sortkey3 =
    # own recency (desc); then the display column and the path fzf acts on.
    display_rows+=("${gmax}"$'\t'"${g}"$'\t'"${mt}"$'\t'"$(printf '%s %-26s %s' "$marker" "$g" "$n")"$'\t'"${p}")
  done

  # --with-nth=1 shows and matches only the display column, so typing filters on
  # "repo name" without the absolute path getting in the way; {2} is the path,
  # used by the preview and by the selection below.
  # --height=100% overrides the --height=50% in FZF_DEFAULT_OPTS, which
  # otherwise leaves half the popup empty.
  selected=$(printf '%s\n' "${display_rows[@]}" \
    | sort -t$'\t' -k1,1nr -k2,2 -k3,3nr \
    | cut -f4- \
    | fzf --delimiter=$'\t' --with-nth=1 \
          --height=100% \
          --prompt="  Project: " \
          --header='● live   ○ none    grouped by repo, most active first' \
          --header-first \
          --preview='eza --tree --level=2 --color=always --icons {2} 2>/dev/null || ls -la {2}' \
          --preview-window=right:45%)
  # Recover the path from the selected row.
  selected="${${(@s:	:)selected}[2]}"
fi

[[ -z "$selected" ]] && return 0

# ── session name ──────────────────────────────────────────────────────────────
session_name=$(tmux-session-name "$selected" 2>/dev/null)

if [[ -z "$session_name" ]]; then
  print -u2 -- "tmux-sessionizer: could not derive a session name for $selected"
  return 1
fi

if ! tmux has-session -t="$session_name" 2>/dev/null; then
  tmux new-session -ds "$session_name" -c "$selected"
fi

if [[ -n "$TMUX" ]]; then
  tmux switch-client -t="$session_name"
else
  tmux attach-session -t="$session_name"
fi
