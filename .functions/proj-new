#!/bin/zsh
# proj-new: interactive project initialization
#
# Part of the proj-* command family. Sets up a git worktree project from scratch
# or from an existing remote, creates a tmux session with your preferred layout,
# optionally creates a GitHub remote, and optionally saves a per-project
# tmuxinator file for fast future re-entry.
#
# Usage:
#   proj-new             — fully interactive (recommended)
#   proj-new --clone     — skip mode prompt, go straight to clone flow
#   proj-new --new       — skip mode prompt, go straight to init flow

# ── helpers ───────────────────────────────────────────────────────────────────

_proj_header() {
  echo ""
  echo "  \033[1;35m󰓩  proj-new\033[0m  \033[2m$1\033[0m"
  echo "  \033[2m─────────────────────────────────────────\033[0m"
}

_proj_confirm() {
  # _proj_confirm "Question text" [default: y|n]
  local question="$1" default="${2:-n}"
  local prompt
  if [[ "$default" == "y" ]]; then
    prompt="[Y/n]"
  else
    prompt="[y/N]"
  fi
  printf "  \033[1m%s\033[0m %s " "$question" "$prompt"
  local answer
  read -r answer
  answer="${answer:-$default}"
  [[ "${answer:l}" == "y" ]]
}

_proj_fzf_layout() {
  printf '%s\n' "agent  — nvim + opencode + shell" \
                "review — lazygit + opencode" \
                "watch  — opencode + test watcher + git status" \
                "none   — plain shell session" \
    | fzf --prompt="  Layout: " \
          --height=8 \
          --layout=reverse \
          --no-info \
    | awk '{print $1}'
}

_proj_save_tmuxinator() {
  local session_name="$1" root_path="$2" layout="$3"
  local tmux_panes=""

  case "$layout" in
    agent)
      tmux_panes="      panes:
        - /home/linuxbrew/.linuxbrew/bin/nvim
        - /home/linuxbrew/.linuxbrew/bin/opencode
        -"
      local tmux_layout="main-vertical"
      ;;
    review)
      tmux_panes="      panes:
        - /home/linuxbrew/.linuxbrew/bin/lazygit
        - /home/linuxbrew/.linuxbrew/bin/opencode"
      local tmux_layout="even-horizontal"
      ;;
    watch)
      tmux_panes="      panes:
        - claude
        - \$WATCH_TEST_CMD
        - watch -n 5 'git status -sb'"
      local tmux_layout="main-vertical"
      ;;
    *)
      tmux_panes="      panes:
        -"
      local tmux_layout="main-vertical"
      ;;
  esac

  local dest="$HOME/.config/tmuxinator/${session_name}.yml"
  cat > "$dest" <<EOF
# Generated by proj-new — $(date +%Y-%m-%d)
name: ${session_name}
root: ${root_path}

windows:
  - main:
      layout: ${tmux_layout}
${tmux_panes}
EOF
  echo "  Saved: $dest"
  echo "  Restore anytime with: muxs ${session_name}  or  Ctrl-a S"
}

# ── main ──────────────────────────────────────────────────────────────────────
proj-new() {
  local mode=""

  # parse flags
  for arg in "$@"; do
    case "$arg" in
      --clone) mode="clone" ;;
      --new)   mode="init"  ;;
    esac
  done

  # ── Step 1: mode selection ─────────────────────────────────────────────────
  if [[ -z "$mode" ]]; then
    _proj_header "Step 1/6 — Choose mode"
    mode=$(printf '%s\n' "clone  — pull from an existing GitHub / remote repo" \
                         "init   — start a fresh local repo" \
      | fzf --prompt="  Mode: " \
            --height=6 \
            --layout=reverse \
            --no-info \
      | awk '{print $1}')
    [[ -z "$mode" ]] && { echo "  Cancelled."; return 0; }
  fi

  # ── Step 2: gather source details ──────────────────────────────────────────
  local repo_url="" repo_name="" org="" worktree_root=""

  if [[ "$mode" == "clone" ]]; then
    _proj_header "Step 2/6 — Select repository"

    # Try gh CLI first for a searchable list
    local selected_repo=""
    if command -v gh &>/dev/null && gh auth status &>/dev/null 2>&1; then
      echo "  Fetching your GitHub repos…"
      selected_repo=$(
        gh repo list --limit 200 --json nameWithOwner,description,isPrivate \
          2>/dev/null \
          | jq -r '.[] | "\(.nameWithOwner)\t\(if .isPrivate then "private" else "public" end)\t\(.description // "")"' \
          | column -t -s $'\t' \
          | fzf --prompt="  GitHub repo: " \
                --height=40% \
                --layout=reverse \
                --header="  Enter = select  |  ESC = enter URL manually" \
                --preview='gh repo view $(echo {} | awk "{print \$1}") 2>/dev/null || echo "(no preview)"' \
                --preview-window=right:50% \
        | awk '{print $1}'
      )
    fi

    if [[ -n "$selected_repo" ]]; then
      repo_url="https://github.com/${selected_repo}.git"
      repo_name=$(basename "$selected_repo")
      org=$(dirname "$selected_repo")
    else
      # Manual URL fallback
      printf "  Repo URL: "
      read -r repo_url
      [[ -z "$repo_url" ]] && { echo "  Cancelled."; return 0; }
      repo_name=$(basename "$repo_url" .git)
      # Try to extract org from URL
      if [[ "$repo_url" =~ github\.com[:/]([^/]+)/ ]]; then
        org="${match[1]}"
      else
        printf "  Org / owner name: "
        read -r org
      fi
    fi

  else
    # init mode
    _proj_header "Step 2/6 — New project details"

    printf "  Project name: "
    read -r repo_name
    [[ -z "$repo_name" ]] && { echo "  Cancelled."; return 0; }

    # org: fzf over existing orgs in ~/source/repos + manual entry option
    local existing_orgs=()
    for d in "$HOME/source/repos"/*/; do
      [[ -d "$d" ]] && existing_orgs+=("$(basename "$d")")
    done

    if [[ ${#existing_orgs[@]} -gt 0 ]]; then
      org=$(printf '%s\n' "${existing_orgs[@]}" "[ enter new org name ]" \
        | fzf --prompt="  Org: " \
              --height=10 \
              --layout=reverse \
              --no-info)
      if [[ "$org" == "[ enter new org name ]" || -z "$org" ]]; then
        printf "  Org name: "
        read -r org
      fi
    else
      printf "  Org name: "
      read -r org
    fi
    [[ -z "$org" ]] && { echo "  Cancelled."; return 0; }
  fi

  # ── Step 3: branch name ────────────────────────────────────────────────────
  _proj_header "Step 3/6 — Initial branch"
  printf "  Branch name [main]: "
  read -r branch
  branch="${branch:-main}"

  # ── Step 4: layout selection ───────────────────────────────────────────────
  _proj_header "Step 4/6 — Tmux layout"
  local layout
  layout=$(_proj_fzf_layout)
  [[ -z "$layout" ]] && layout="agent"

  # ── Step 5: GitHub remote ──────────────────────────────────────────────────
  local create_remote=false remote_visibility="private"
  _proj_header "Step 5/6 — GitHub remote"
  if _proj_confirm "Create a GitHub remote?" n; then
    create_remote=true
    remote_visibility=$(printf '%s\n' "private" "public" \
      | fzf --prompt="  Visibility: " \
            --height=5 \
            --layout=reverse \
            --no-info)
    [[ -z "$remote_visibility" ]] && remote_visibility="private"
  fi

  # ── Step 6: per-project tmuxinator file ───────────────────────────────────
  local save_mux=false
  _proj_header "Step 6/6 — Per-project tmuxinator file"
  echo "  Saves a named tmuxinator YAML so you can restore this exact layout"
  echo "  later with  muxs <session>  or  Ctrl-a S"
  echo ""
  _proj_confirm "Save per-project tmuxinator file?" y && save_mux=true

  # ── Execute ────────────────────────────────────────────────────────────────
  echo ""
  echo "  \033[1;35m󰓩 Setting up project…\033[0m"
  echo ""

  local dest="$HOME/source/repos/$org/$repo_name"

  if [[ "$mode" == "clone" ]]; then
    gwt-clone "$repo_url" "$org" || return 1
  else
    gwt-init "$repo_name" "$org" || return 1
  fi

  # The worktree for $branch should now exist under $dest/$branch
  local worktree_path="$dest/$branch"
  local session_name
  session_name=$(echo "${repo_name}_${branch}" | tr ' .:/\\' '_____')

  # Create GitHub remote if requested
  if $create_remote; then
    echo ""
    echo "  Creating GitHub remote (${remote_visibility})…"
    (
      cd "$worktree_path"
      gh repo create "${org}/${repo_name}" \
        "--${remote_visibility}" \
        --source=. \
        --remote=origin \
        --push 2>/dev/null \
        || gh repo create "${repo_name}" \
             "--${remote_visibility}" \
             --source=. \
             --remote=origin \
             --push
    ) && echo "  Remote created: github.com/${org}/${repo_name}"
  fi

  # Save per-project tmuxinator YAML
  if $save_mux && [[ "$layout" != "none" ]]; then
    echo ""
    echo "  Saving tmuxinator project file…"
    _proj_save_tmuxinator "$session_name" "$worktree_path" "$layout"
  fi

  # Launch layout
  echo ""
  if [[ "$layout" == "none" ]]; then
    if ! tmux has-session -t="$session_name" 2>/dev/null; then
      tmux new-session -ds "$session_name" -c "$worktree_path"
    fi
    [[ -n "$TMUX" ]] && tmux switch-client -t="$session_name" \
                     || tmux attach-session -t="$session_name"
  else
    echo "  Launching '$layout' layout…"
    tmux-layout "$layout" "$worktree_path" "$session_name"
  fi

  echo ""
  echo "  \033[1;32m✓ Done.\033[0m  Session: \033[1m$session_name\033[0m  →  $worktree_path"
}

# Autoload stub: on first call the file content runs as the stub body, which
# defines the helpers above and redefines proj-new() — then we delegate here.
proj-new "$@"
