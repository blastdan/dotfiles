#!/bin/bash
# Copy this to ~/.config/mise/secrets.sh (gitignored)
# Loads secrets from Google Secret Manager with local fallback

# --- GitHub PAT ---
if command -v gcloud &>/dev/null && gcloud auth print-access-token &>/dev/null 2>&1; then
  export GITHUB_PAT=$(gcloud secrets versions access latest --secret="github-pat" --project="<gcp-secrets-project>" 2>/dev/null)
fi
# Fallback to local file
if [[ -z "$GITHUB_PAT" ]] && [[ -f "$HOME/.secrets.local" ]]; then
  source "$HOME/.secrets.local"
fi
