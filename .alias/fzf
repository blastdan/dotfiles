# ── fzf global defaults ───────────────────────────────────────────────────────
# Use fd as the backend: faster, respects .gitignore, no hidden files by default
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'

# Catppuccin Macchiato colors + consistent UX defaults
export FZF_DEFAULT_OPTS="
  --height=50%
  --layout=reverse
  --border=rounded
  --prompt='  '
  --pointer='▶'
  --marker='✓'
  --ansi
  --cycle
  --bind='ctrl-/:toggle-preview'
  --bind='ctrl-u:preview-half-page-up'
  --bind='ctrl-d:preview-half-page-down'
  --color=bg+:#363a4f,bg:#24273a,spinner:#f4dbd6,hl:#ed8796
  --color=fg:#cad3f5,header:#ed8796,info:#c6a0f6,pointer:#f4dbd6
  --color=marker:#b7bdf8,fg+:#cad3f5,prompt:#c6a0f6,hl+:#ed8796
  --color=selected-bg:#494d64,border:#5b6078,label:#cad3f5
"

# Ctrl-T: preview files with bat
export FZF_CTRL_T_OPTS="
  --preview='bat --color=always --style=numbers --line-range=:100 {}'
  --preview-window=right:55%
"

# Alt-C: preview directory tree with eza
export FZF_ALT_C_OPTS="
  --preview='eza --tree --level=2 --color=always --icons {}'
  --preview-window=right:45%
"

# Ctrl-R: show full command, no truncation
export FZF_CTRL_R_OPTS="
  --preview='echo {}'
  --preview-window=down:3:wrap
  --bind='ctrl-y:execute-silent(echo -n {2..} | xclip -sel clip)+abort'
"

# ── helper functions ──────────────────────────────────────────────────────────

# fman: browse and open man pages with fzf
fman() {
  local page
  page=$(man -k . | fzf \
    --prompt='  man: ' \
    --preview='echo {} | awk "{print \$1}" | xargs -I% man % | col -bx | bat --color=always --style=plain --language=man' \
    --preview-window=right:60% \
  ) && man "$(echo "$page" | awk '{print $1}')"
}

# fenv: fuzzy search environment variables
fenv() {
  env | sort | fzf \
    --prompt='  env: ' \
    --preview='echo {}' \
    --preview-window=down:3:wrap
}
