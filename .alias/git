# ── worktrees ─────────────────────────────────────────────────────────────────
alias gwts='git worktree'                # raw git worktree subcommand
alias gwtl='git worktree list'           # list all worktrees
alias gwta='gwt-add'                     # add worktree (+ tmux only with --session/--layout)
alias gwtc='gwt-clone'                   # bare-clone a repo ready for worktrees
alias gwti='gwt-init'                    # init a new repo with bare worktree layout
alias gwtf='gwt'                         # fzf worktree picker (autoloaded function)
alias gwtp='gwt-pull-all'                # fetch all + fast-forward every branch
alias gwtrm='git worktree remove'        # remove a worktree directory
alias gwtrmf='git worktree remove --force' # force-remove (unclean worktree)
alias gwtpr='git worktree prune'         # prune stale worktree metadata
alias gwtt='gwt-tidy'                    # review + remove merged worktrees (branches kept)

# ── project commands (proj-*) ──────────────────────────────────────────────────
alias gpn='proj-new'                     # interactive project init (clone or new)

# ── fzf-powered git functions ─────────────────────────────────────────────────

# gcof: interactive branch checkout — shows log preview for each branch
gcof() {
  local branch
  branch=$(git branch --all --sort=-committerdate \
    | grep -v 'HEAD\|^$' \
    | sed 's|remotes/origin/||' \
    | sort -u \
    | fzf \
        --prompt='  branch: ' \
        --preview='git log --oneline --graph --color=always --decorate -20 $(echo {} | sed "s/^[* ]*//" | sed "s/ .*//")' \
        --preview-window=right:55% \
  ) && git checkout "$(echo "$branch" | sed 's/^[* ]*//' | sed 's/ .*//')"
}

# gadd: interactive git add — shows diff for each file while staging
gadd() {
  local files
  files=$( (git diff --name-only HEAD 2>/dev/null; git ls-files --others --exclude-standard) \
    | sort -u \
    | fzf \
        --multi \
        --prompt='  stage: ' \
        --preview='git diff --color=always HEAD -- {} 2>/dev/null || bat --color=always {}' \
        --preview-window=right:60% \
        --bind='tab:toggle')
  [[ -n "$files" ]] && echo "$files" | xargs git add && git status --short
}

# gshow: browse git log and show full diff for each commit
gshow() {
  git log --oneline --graph --color=always --decorate "$@" \
    | fzf \
        --ansi \
        --no-sort \
        --prompt='  commit: ' \
        --preview='git show --color=always --stat $(echo {} | grep -oP "[a-f0-9]{6,}" | head -1)' \
        --preview-window=right:60% \
        --bind='enter:execute(git show --color=always $(echo {} | grep -oP "[a-f0-9]{6,}" | head -1) | bat --color=always --style=plain | less -R)'
}

# gstashf: interactive stash browser — preview diff, enter to apply
gstashf() {
  local stash
  stash=$(git stash list \
    | fzf \
        --prompt='  stash: ' \
        --preview='git stash show -p --color=always $(echo {} | cut -d: -f1)' \
        --preview-window=right:60% \
  ) && git stash apply "$(echo "$stash" | cut -d: -f1)"
}

